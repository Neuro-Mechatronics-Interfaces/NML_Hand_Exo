digraph "control_flow" {
  graph [layout=neato, overlap=false, splines=true, labelloc=t, label="control_flow"];
  "vel_ref" [color="#334155", fillcolor="#fce7f3", fontname="Arial", fontsize="10", height="0.5", label="Velocity reference\nprofile or assist map", margin="0.10,0.06", pin="true", pos="0.0,0.0!", shape="box", style="rounded,filled", width="1.4188"];
  "objective" [color="#334155", fillcolor="#dbeafe", fontname="Arial", fontsize="10", height="0.62", label="Objective\nhold / trajectory /\ntorque assist / direct command", margin="0.10,0.06", pin="true", pos="285.5,0.0!", shape="box", style="rounded,filled", width="2.075"];
  "input" [color="#334155", fillcolor="#dbeafe", fontname="Arial", fontsize="10", height="0.62", label="Scenario inputs\nstart/end, duration,\nexternal effort, endstop", margin="0.10,0.06", pin="true", pos="571.0,0.0!", shape="box", style="rounded,filled", width="1.575"];
  "current_cmd" [color="#334155", fillcolor="#fee2e2", fontname="Arial", fontsize="10", height="0.5", label="Signed current\nCURRENT mode", margin="0.10,0.06", pin="true", pos="856.5,0.0!", shape="box", style="rounded,filled", width="1.2104"];
  "external_profile" [color="#334155", fillcolor="#fed7aa", fontname="Arial", fontsize="10", height="0.5", label="External torque profile\npiecewise mean + Gaussian noise", margin="0.10,0.06", pin="true", pos="1142.0,0.0!", shape="box", style="rounded,filled", width="2.2729"];
  "observer" [color="#334155", fillcolor="#fed7aa", fontname="Arial", fontsize="10", height="0.5", label="Motor-side observer\nstate + actuator residual", margin="0.10,0.06", pin="true", pos="1142.0,-123.0!", shape="box", style="rounded,filled", width="1.6688"];
  "zero_bias" [color="#334155", fillcolor="#fed7aa", fontname="Arial", fontsize="10", height="0.5", label="Zero-bias estimator\ncollection epoch", margin="0.10,0.06", pin="true", pos="856.5,-123.0!", shape="box", style="rounded,filled", width="1.3563"];
  "state" [color="#334155", fillcolor="#c7d2fe", fontname="Arial", fontsize="10", height="0.5", label="q, velocity, current\nposition + telemetry", margin="0.10,0.06", pin="true", pos="571.0,-123.0!", shape="box", style="rounded,filled", width="1.3979"];
  "vel_error" [color="#334155", fillcolor="#fce7f3", fontname="Arial", fontsize="10", height="0.5", label="Velocity error\nvref − v", margin="0.10,0.06", pin="true", pos="285.5,-123.0!", shape="box", style="rounded,filled", width="1.0021"];
  "assist_cmd" [color="#334155", fillcolor="#bbf7d0", fontname="Arial", fontsize="10", height="0.5", label="Bounded assist command\ngain + max + ramp", margin="0.10,0.06", pin="true", pos="0.0,-123.0!", shape="box", style="rounded,filled", width="1.7729"];
  "detector" [color="#334155", fillcolor="#fed7aa", fontname="Arial", fontsize="10", height="0.5", label="Sustained detector\nthreshold + delay", margin="0.10,0.06", pin="true", pos="0.0,-246.0!", shape="box", style="rounded,filled", width="1.3354"];
  "vel_pi" [color="#334155", fillcolor="#fce7f3", fontname="Arial", fontsize="10", height="0.5", label="Velocity PI\nVelocity P / I", margin="0.10,0.06", pin="true", pos="285.5,-246.0!", shape="box", style="rounded,filled", width="0.98125"];
  "pos_error" [color="#334155", fillcolor="#dcfce7", fontname="Arial", fontsize="10", height="0.5", label="Position error\nqref − q", margin="0.10,0.06", pin="true", pos="571.0,-246.0!", shape="box", style="rounded,filled", width="1.0021"];
  "pos_ref" [color="#334155", fillcolor="#dcfce7", fontname="Arial", fontsize="10", height="0.5", label="Position reference\nprofile + target shift", margin="0.10,0.06", pin="true", pos="856.5,-246.0!", shape="box", style="rounded,filled", width="1.3563"];
  "endstop" [color="#334155", fillcolor="#fecaca", fontname="Arial", fontsize="10", height="0.5", label="Endstop reaction\nbounded counter-torque", margin="0.10,0.06", pin="true", pos="1142.0,-246.0!", shape="box", style="rounded,filled", width="1.6167"];
  "plant" [color="#334155", fillcolor="#cbd5e1", fontname="Arial", fontsize="10", height="0.62", label="Motor + load\ninertia, friction,\nexternal effort", margin="0.10,0.06", pin="true", pos="1142.0,-369.0!", shape="box", style="rounded,filled", width="1.0854"];
  "mode" [color="#334155", fillcolor="#fef3c7", fontname="Arial", fontsize="10", height="0.5", label="Operating Mode\nDynamixel2Arduino selection", margin="0.10,0.06", pin="true", pos="856.5,-369.0!", shape="box", style="rounded,filled", width="1.95"];
  "pwm_clamp" [color="#334155", fillcolor="#bbf7d0", fontname="Arial", fontsize="10", height="0.5", label="PWM clamp\nPOSITION / VELOCITY", margin="0.10,0.06", pin="true", pos="571.0,-369.0!", shape="box", style="rounded,filled", width="1.6063"];
  "pwm_cmd" [color="#334155", fillcolor="#fee2e2", fontname="Arial", fontsize="10", height="0.5", label="Signed PWM\nPWM mode", margin="0.10,0.06", pin="true", pos="285.5,-369.0!", shape="box", style="rounded,filled", width="1.0021"];
  "pos_pid" [color="#334155", fillcolor="#dcfce7", fontname="Arial", fontsize="10", height="0.5", label="Position PID + FF\nP / I / D / FF", margin="0.10,0.06", pin="true", pos="0.0,-369.0!", shape="box", style="rounded,filled", width="1.2833"];
  "current_clamp" [color="#334155", fillcolor="#bbf7d0", fontname="Arial", fontsize="10", height="0.5", label="Effective Goal Current\nassist-derived <= limit", margin="0.10,0.06", pin="true", pos="0.0,-492.0!", shape="box", style="rounded,filled", width="1.5229"];
  "input" -> "objective" [color="#475569", fontname="Arial", fontsize="9"];
  "objective" -> "mode" [color="#475569", fontname="Arial", fontsize="9"];
  "input" -> "external_profile" [color="#475569", fontname="Arial", fontsize="9"];
  "external_profile" -> "observer" [color="#475569", fontname="Arial", fontsize="9"];
  "observer" -> "zero_bias" [color="#475569", fontname="Arial", fontsize="9"];
  "zero_bias" -> "detector" [color="#475569", fontname="Arial", fontsize="9"];
  "detector" -> "assist_cmd" [color="#475569", fontname="Arial", fontsize="9"];
  "assist_cmd" -> "pos_ref" [color="#475569", fontname="Arial", fontsize="9", label="target shift", style="dashed"];
  "assist_cmd" -> "vel_ref" [color="#475569", fontname="Arial", fontsize="9", label="velocity bias", style="dashed"];
  "assist_cmd" -> "current_cmd" [color="#475569", fontname="Arial", fontsize="9", label="signed current", style="dashed"];
  "mode" -> "pos_ref" [color="#475569", fontname="Arial", fontsize="9", label="POSITION / EXTENDED\nCURRENT_POSITION"];
  "pos_ref" -> "pos_error" [color="#475569", fontname="Arial", fontsize="9"];
  "pos_error" -> "pos_pid" [color="#475569", fontname="Arial", fontsize="9"];
  "pos_pid" -> "current_clamp" [color="#475569", fontname="Arial", fontsize="9", label="CURRENT_POSITION"];
  "pos_pid" -> "pwm_clamp" [color="#475569", fontname="Arial", fontsize="9", label="POSITION / EXTENDED"];
  "mode" -> "vel_ref" [color="#475569", fontname="Arial", fontsize="9", label="VELOCITY"];
  "vel_ref" -> "vel_error" [color="#475569", fontname="Arial", fontsize="9"];
  "vel_error" -> "vel_pi" [color="#475569", fontname="Arial", fontsize="9"];
  "vel_pi" -> "pwm_clamp" [color="#475569", fontname="Arial", fontsize="9"];
  "mode" -> "current_cmd" [color="#475569", fontname="Arial", fontsize="9", label="CURRENT"];
  "mode" -> "pwm_cmd" [color="#475569", fontname="Arial", fontsize="9", label="PWM"];
  "current_clamp" -> "plant" [color="#475569", fontname="Arial", fontsize="9"];
  "pwm_clamp" -> "plant" [color="#475569", fontname="Arial", fontsize="9"];
  "current_cmd" -> "plant" [color="#475569", fontname="Arial", fontsize="9"];
  "pwm_cmd" -> "plant" [color="#475569", fontname="Arial", fontsize="9"];
  "objective" -> "vel_ref" [color="#475569", fontname="Arial", fontsize="9", label="assist mapping", style="dashed"];
  "objective" -> "current_cmd" [color="#475569", fontname="Arial", fontsize="9", label="assist mapping", style="dashed"];
  "plant" -> "endstop" [color="#475569", fontname="Arial", fontsize="9"];
  "endstop" -> "state" [color="#475569", fontname="Arial", fontsize="9"];
  "plant" -> "state" [color="#475569", fontname="Arial", fontsize="9"];
  "state" -> "pos_error" [color="#475569", fontname="Arial", fontsize="9", label="feedback", style="dashed"];
  "state" -> "vel_error" [color="#475569", fontname="Arial", fontsize="9", label="feedback", style="dashed"];
}
