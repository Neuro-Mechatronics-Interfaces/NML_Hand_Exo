digraph usb_protocol {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];
  DISCOVER [label="AutoSerialComm: open candidate CDC\nLegacy text probe, then framed HELLO"];
  LEGACY [label="ascii-nx: SerialComm / DualSerialComm\nText commands; NX on primary CDC"];
  BINARY [label="protobuf-v1: ProtobufSerialComm\nPrimary text / secondary binary RPC\nFeatures gate model, batch, typed assist + one-click Enable"];
  V2 [label="protobuf-v2: ProtobufV2SerialComm\nHELLO returns typed discovery metadata\n(text protobuf-v2 fallback for old firmware)\nTEXT_COMMAND keeps maintenance surface typed\nResponse payloads use a oneof"];
  REJECT [label="Unknown protocol / missing sibling\nClose ports; no fallback guess", fillcolor="#fbeeee"];
  SDK [label="HandExo API / GUI / benchmark\nTyped metadata maps to legacy info keys\nTyped motor/model calls and common NX decoder\nAssist heartbeat includes numeric status snapshot"];
  DISCOVER -> LEGACY [label="legacy metadata or ascii-nx"];
  DISCOVER -> BINARY [label="explicit metadata + compatible runtime"];
  DISCOVER -> V2 [label="typed HELLO or legacy text fallback"];
  DISCOVER -> REJECT [label="unsupported or incomplete layout"];
  LEGACY -> SDK;
  BINARY -> SDK [label="typed telemetry/motion RPCs\nprimary-text maintenance + shadow"];
  V2 -> SDK [label="typed telemetry/motion/current-limit RPCs\nall inbound results on response CDC"];
}
