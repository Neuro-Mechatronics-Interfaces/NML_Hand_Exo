digraph rom_pulse {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];
  PULSE [label="Powered pulse: 40 ms, shaped\n5-ms Gaussian / optional 10-ms triangle\nStart 40 mA; cap 160 mA; measured travel checks\nStart requires valid position inside limits"];
  REST [label="Arm here: zero current, read position\nRest >=250 ms; quiet range <=0.18 deg for 200 ms\nSpeed <=1.5 deg/s; original deadline 1500 ms"];
  FEEDBACK [label="Read position + velocity; correct model\nUpdate local displacement response + eligible gain\nPredict next pulse for 0.65 deg; max 6 mA change"];
  RETURN [label="Optional return (disabled by default)\nNon-fault outcomes only; 20 mA / 4 s timeout"];
  DONE [label="Zero current / torque off; report result\nFault ends campaign; limits require Apply"];
  PULSE -> REST [label="deadline / 1-deg travel / excessive mean speed"];
  PULSE -> REST [label="position read fails: zero current\nup to 3 recovery rests; same amplitude", color="#a63"];
  REST -> PULSE [label="first pulse or recovered feedback\nno fit / stall update for an uncompleted pulse", color="#a63"];
  REST -> FEEDBACK [label="rest elapsed and measured settling"];
  FEEDBACK -> REST [label="pre-pulse recheck not quiet: wait at zero\nretain chosen amplitude; no duplicate fit"];
  FEEDBACK -> PULSE [label="continue: bounded predicted-amplitude step\ncheck stored limits before applying"];
  FEEDBACK -> DONE [label="endstop: moving evidence + 3 stable ceiling pulses\nor ceiling / 6 low-response ceiling pulses"];
  FEEDBACK -> RETURN [label="return explicitly enabled", style=dashed];
  PULSE -> DONE [label="stored limit / fault / watchdog"];
  REST -> DONE [label="outside limits / 3-deg excursion\nsettling failure / watchdog"];
  RETURN -> DONE;
  PULSE -> DONE [label="stop / disable / retries exhausted\nor late deadline", color="#a33"];
  REST -> DONE [label="stop / disable / retries exhausted", color="#a33"];
}
