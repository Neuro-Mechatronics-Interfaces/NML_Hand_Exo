digraph secondary { rankdir=TB; node [shape=box, style="rounded,filled", fillcolor="#eef4fb"]; WAIT [label="Sensing\nFiltered effort, 500 ms intent dwell"]; MOVE [label="Assisting\nIntegrate secondary goal; grow bounded lead"]; HOLD [label="Captured hold\nCancel lead; block rearm"]; WAIT -> MOVE [label="sustained effort"]; MOVE -> HOLD [label="500 ms low effort or stalled progress"]; HOLD -> HOLD [label="persistent effort; decay internal lead"]; HOLD -> WAIT [label="500 ms relaxed effort"]; MOVE -> MOVE [label="measured progress continues"]; }