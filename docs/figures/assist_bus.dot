digraph assist_bus { rankdir=TB; node [shape=box, style="rounded,filled", fillcolor="#eef4fb"]; feedback [label="All selected IDs\nSync Read 126..135\ncurrent / velocity / position"]; torque [label="Same selected IDs\nSync Read 64\ntorque status"]; control [label="Validate whole frame\nUpdate every secondary goal\nValidate complete goal batch"]; goals [label="Changed IDs together\nAt most one Sync Write 116..119"]; stop [label="Fault / stop\nGrouped zero current + torque-off\nSync Read confirms disable"]; feedback -> torque; torque -> control; control -> goals; goals -> feedback [label="next due 20-ms pass"]; feedback -> stop [label="partial / status error"]; torque -> stop [label="partial / disabled"]; control -> stop [label="feedback / goal / lease fault"]; goals -> stop [label="TX failure"]; }