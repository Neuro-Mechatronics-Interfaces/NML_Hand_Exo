digraph assist {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];
  OFF [label="OFF\nGUI active-side IDs; shared threshold, gain and maximum cap"];
  WAIT [label="GUI STATIONARY CHECK (read-only)\nFresh measured speed + position quiet for 500 ms\n5 s deadline; Stop cancels unsent Enable"];
  {rank=same; OFF; WAIT;}
  BIAS [label="INITIAL BASELINE\nGrouped mode + capped hold setup for selected IDs\n50 stationary samples (about 1 s); existing budget respected"];
  READY [label="READY (legacy manual SDK only)\nHold pose; heartbeat required\nWait for explicit Start"];
  ACTIVE [label="ACTIVE\nSync Read selection; integrate secondary goal + lead\nOne goal Sync Write; release on stalled progress"];
  STOP [label="STOP / FAULT\nGrouped zero current + torque-off; Sync Read confirms disable\nRetain ownership and retry if unconfirmed"];
  OFF -> WAIT [label="GUI Enable Torque-Assist"];
  WAIT -> BIAS [label="one Enable request after quiet readings\nfirmware checks IDs, pose and current headroom"];
  OFF -> BIAS [label="direct SDK / legacy calibration"];
  WAIT -> STOP [label="timeout / invalid feedback / stop"];
  BIAS -> ACTIVE [label="automatic after valid baseline\nhost lease deadline preserved"];
  BIAS -> READY [label="legacy calibrate request only"];
  READY -> ACTIVE [label="legacy explicit Start"];
  ACTIVE -> ACTIVE [label="per-joint intent / progress / release"];
  BIAS -> STOP [label="fault / stop / lost heartbeat"];
  READY -> STOP [label="fault / stop / lost heartbeat"];
  ACTIVE -> STOP [label="fault / stop / lost heartbeat"];
  STOP -> OFF [label="torque-off confirmed; bias invalidated"];
}
